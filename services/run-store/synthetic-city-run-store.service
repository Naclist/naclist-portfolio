[Unit]
Description=Synthetic City 24-hour run JSON store
After=network.target

[Service]
Type=simple
User=naclist
Group=naclist
WorkingDirectory=/home/naclist/synthetic-city-run-store
Environment=RUN_STORE_DIR=/home/naclist/synthetic-city-run-store/data
Environment=RUN_STORE_RETENTION_SECONDS=86400
Environment=RUN_STORE_MAX_UPLOAD_BYTES=2097152
Environment=RUN_STORE_MAX_STORE_BYTES=268435456
Environment=RUN_STORE_MAX_FILES=200
Environment=RUN_STORE_UPLOADS_PER_HOUR=30
Environment=RUN_STORE_ORIGINS=https://naclist.github.io
ExecStart=/home/naclist/synthetic-city-run-store/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 5010 --workers 1
Restart=always
RestartSec=5
MemoryMax=256M
CPUQuota=40%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
